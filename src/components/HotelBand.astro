---
import IconOpen from "~icons/material-symbols-light/open-in-new-rounded";

interface Props {
  name: string;
  url: string;
  description: string;
}

const { name, url, description } = Astro.props;
---

<section id="hotel" aria-labelledby="h-hotel" class="band">
  <div class="inner">
    <div class="head">
      <div class="label kicker">泊まる</div>
      <h2 id="h-hotel">
        <a href={url} target="_blank" rel="noopener">{name}<IconOpen aria-hidden="true" /></a>
      </h2>
      <p class="muted">{description}</p>
    </div>
    <div class="grid"><slot /></div>
    <slot name="access" />
  </div>
</section>

<style>
  .band {
    background: var(--ice-100);
  }
  .inner {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 760px;
  }
  .kicker {
    letter-spacing: 0.08em;
  }
  h2 {
    font-size: var(--text-heading-regular);
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-weight: 600;
  }
  h2 a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--glacier-deep);
  }
  h2 svg {
    font-size: 20px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }
  /* 帯の上では罫線を白に */
  .inner :global(.card) {
    border-color: rgba(255, 255, 255, 0.9);
  }
</style>
