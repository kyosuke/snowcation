---
import Button from "./Button.astro";

interface Lift {
  name: string;
  capacity: number;
  length: number;
  type?: "gondola" | "express" | "fixed";
  hood?: boolean;
  footrest?: boolean;
  safetyBar?: boolean;
  cabin?: "narrow" | "standard" | "wide";
  rack?: boolean; // 板を外付けラックに入れるゴンドラ
  hours?: string;
}

interface Props {
  title?: string;
  statusUrl: string;
  groups: { name?: string; lifts: Lift[] }[];
  note?: string;
}

const { title = "リフト", statusUrl, groups, note } = Astro.props;

// 公称最高速より遅めにして減速分を含める。30秒以上は切り上げ
const SPEED = { gondola: 4.0, express: 4.0, fixed: 2.0 };
const MAX_LENGTH = 4000;
// 1,000m ごとの目盛り。バーの中は白、トラック上は Ink の破線で描く
const TICKS = [1000, 2000, 3000].map((m) => (m / MAX_LENGTH) * 100);
const cabinLabel = { narrow: "キャビン狭め", standard: "キャビン普通", wide: "キャビン広め" };

const row = (l: Lift) => {
  const type = l.type ?? "fixed";
  const minutes = Math.round(l.length / SPEED[type] / 60);
  const chips = [
    ...(l.rack ? ["板は外付けラック"] : []),
    ...(l.hood ? ["フード"] : []),
    ...(l.footrest ? ["足置き"] : []),
    ...(l.safetyBar ? ["安全バー"] : []),
  ];
  const sub = [
    type === "gondola" ? `${l.capacity}人乗りゴンドラ` : type === "express" ? `${l.capacity}人乗り・高速` : `${l.capacity}人乗り`,
    ...(l.cabin ? [cabinLabel[l.cabin]] : []),
    ...(l.hours ? [l.hours] : []),
  ].join(" · ");
  const width = Math.min(100, (l.length / MAX_LENGTH) * 100);
  return { ...l, minutes, chips, sub, width, ticks: TICKS.filter((t) => t < width).map((t) => (t / width) * 100) };
};
---

<section id="lifts" aria-labelledby="h-lifts" class="lifts">
  <div class="card">
    <div class="head">
      <h2 id="h-lifts" class="h2">{title}</h2>
      <Button href={statusUrl} variant="outline">現在の運行状況（公式）</Button>
    </div>
    {
      groups.map((g) => (
        <div class="group">
          {g.name && <h3 class="h3">{g.name}</h3>}
          {g.lifts.map(row).map((l) => (
            <div class="row">
              <div class="info">
                <div class="name">
                  <span>{l.name}</span>
                  {l.chips.map((c) => (
                    <span class="chip">{c}</span>
                  ))}
                </div>
                <div class="sub">{l.sub}</div>
              </div>
              <div class="bar">
                <div class="track">
                  {TICKS.map((t) => (
                    <div class="tick" style={`left: ${t}%`} aria-hidden="true" />
                  ))}
                  <div class="fill" style={`width: ${l.width}%`}>
                    {l.ticks.map((t) => (
                      <div class="tick" style={`left: ${t}%`} aria-hidden="true" />
                    ))}
                  </div>
                </div>
                <span class="value"><strong>{l.length.toLocaleString("ja-JP")}m</strong> / 約{l.minutes}分</span>
              </div>
            </div>
          ))}
        </div>
      ))
    }
    <p class="foot">
      乗車時間は種別の標準速度（ゴンドラ・高速 4.0m/s、固定循環 2.0m/s）からの概算です。減速運転のときは長くなります。{note}
    </p>
  </div>
  <div class="extra"><slot /></div>
</section>

<style>
  .lifts {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .card {
    padding-bottom: 20px;
    gap: 24px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
  }
  .group {
    display: flex;
    flex-direction: column;
  }
  .group .h3 {
    padding-bottom: 8px;
    color: var(--ink-2);
    border-bottom: 1px solid var(--ice-100);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--snow-2);
  }
  .row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .info {
    flex: 1 1 260px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    font-weight: 600;
    line-height: 1.5;
  }
  .sub {
    font-size: var(--text-caption);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .bar {
    flex: 1 1 200px;
    max-width: 420px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .track {
    position: relative;
    flex: 1;
    height: 8px;
    border-radius: 4px;
    background: var(--snow-2);
  }
  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 4px;
    background: var(--glacier);
    overflow: hidden;
  }
  /* SeasonTimeline と同じ 2 層の目盛り。トラック上は Ink、バーの中は白 */
  .tick {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 1px dashed rgba(16, 35, 58, 0.26);
  }
  .fill .tick {
    border-left-color: rgba(255, 255, 255, 0.7);
  }
  .value {
    width: 112px;
    text-align: right;
    font-size: var(--text-body-weak);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .value strong {
    color: var(--ink);
  }
  .foot {
    font-size: var(--text-caption);
    line-height: 1.6;
    color: var(--ink-3);
  }
  .extra {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }
  .extra:empty {
    display: none;
  }
</style>
