---
import { md, today, type Period } from "../lib/season";

interface Props {
  name?: string;
  periods: Period[];
  closures?: { start: string; end: string; reason?: string }[];
}

const { name, periods, closures = [] } = Astro.props;

// 11/1〜5月末の固定軸。開始日は朝、終了日は夕方として幅を取る
const parseStart = (s: string) => new Date(`${s}T06:00:00+09:00`);
const parseEnd = (s: string) => new Date(`${s}T18:00:00+09:00`);
const first = parseStart(periods[0].start);
const baseYear = first.getMonth() >= 6 ? first.getFullYear() : first.getFullYear() - 1;
const axisStart = new Date(baseYear, 10, 1);
const axisEnd = new Date(baseYear + 1, 5, 1);
const pct = (d: Date) => ((d.getTime() - axisStart.getTime()) / (axisEnd.getTime() - axisStart.getTime())) * 100;

const monthStarts = Array.from({ length: 7 }, (_, i) => new Date(baseYear, 10 + i, 1));
const monthLabels = monthStarts.map((d, i) => ({
  label: `${d.getMonth() + 1}月`,
  center: (pct(d) + pct(monthStarts[i + 1] ?? axisEnd)) / 2,
}));
const boundaries = monthStarts.slice(1).map(pct);

const segments = periods.map((p, i) => {
  const left = pct(parseStart(p.start));
  const right = pct(parseEnd(p.end));
  return {
    ...p,
    left,
    width: right - left,
    radius: `${i === 0 ? 8 : 0}px ${i === periods.length - 1 ? 8 : 0}px ${i === periods.length - 1 ? 8 : 0}px ${i === 0 ? 8 : 0}px`,
    // バーの中の月区切りは白で描く（トラック側の線はバーに隠れる）
    lines: boundaries.filter((b) => b > left && b < right).map((b) => ((b - left) / (right - left)) * 100),
  };
});

const closureSegments = closures.map((c) => {
  const left = pct(parseStart(c.start));
  const right = pct(parseEnd(c.end));
  const l = periods.some((p) => p.start === c.start) ? 8 : 0;
  const r = periods.some((p) => p.end === c.end) ? 8 : 0;
  return { ...c, left, width: right - left, radius: `${l}px ${r}px ${r}px ${l}px` };
});

const t = parseStart(today());
const todayPct = t >= axisStart && t < axisEnd ? pct(t) : null;
const range = (p: { start: string; end: string }) => `${md(p.start)}〜${md(p.end)}`;
---

<div class="timeline">
  {name && <h3 class="h3">{name}</h3>}
  <div class="track">
    {boundaries.map((b) => <div class="gridline" style={`left: ${b}%`} aria-hidden="true" />)}
    {
      segments.map((s) => (
        <div
          class="seg"
          data-kind={s.kind}
          style={`left: ${s.left}%; width: ${s.width}%; border-radius: ${s.radius}`}
          title={`${s.name} ${range(s)}`}
        >
          {s.lines.map((l) => (
            <div class="inline" style={`left: ${l}%`} aria-hidden="true" />
          ))}
        </div>
      ))
    }
    {
      closureSegments.map((c) => (
        <div
          class="closure"
          style={`left: ${c.left}%; width: ${c.width}%; border-radius: ${c.radius}`}
          title={`クローズ ${range(c)}`}
        />
      ))
    }
    {todayPct !== null && <div class="today" style={`left: ${todayPct}%`} title="今日" />}
  </div>
  <div class="axis">{monthLabels.map((m) => <span style={`left: ${m.center}%`}>{m.label}</span>)}</div>
  <ul class="legend">
    {
      segments.map((s) => (
        <li>
          <span class="key" data-kind={s.kind} /><strong>{s.name}</strong>{range(s)}
        </li>
      ))
    }
    {
      closureSegments.length > 0 && (
        <li>
          <span class="key closure-key" /><strong>クローズ</strong>
          {closureSegments.map((c) => `${range(c)}${c.reason ? `（${c.reason}）` : ""}`).join("・")}
        </li>
      )
    }
  </ul>
</div>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .track {
    position: relative;
    height: 28px;
    border-radius: 8px;
    background: var(--snow-2);
  }
  .gridline,
  .inline {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 1px dashed rgba(16, 35, 58, 0.26);
  }
  .inline {
    border-left-color: rgba(255, 255, 255, 0.7);
  }
  .seg,
  .closure,
  .today {
    position: absolute;
    top: 0;
    bottom: 0;
  }
  .seg {
    overflow: hidden;
  }
  .seg[data-kind="on"],
  .key[data-kind="on"] {
    background: var(--glacier);
  }
  .seg[data-kind="pre"],
  .seg[data-kind="spring"],
  .key[data-kind="pre"],
  .key[data-kind="spring"] {
    background: var(--ice-300);
  }
  /* 予定の塗りを透かす白ストライプ */
  .closure {
    background: repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.88) 0 3px, rgba(255, 255, 255, 0.35) 3px 8px);
    box-shadow: inset 0 0 0 1px rgba(16, 35, 58, 0.18);
  }
  .today {
    width: 2px;
    margin-left: -1px;
    background: var(--ink);
  }
  .axis {
    position: relative;
    height: 18px;
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .axis span {
    white-space: nowrap;
    position: absolute;
    transform: translateX(-50%);
  }
  .legend {
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    font-size: var(--text-caption);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .legend strong {
    color: var(--ink);
  }
  .key {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    flex-shrink: 0;
  }
  .closure-key {
    background:
      repeating-linear-gradient(-45deg, rgba(255, 255, 255, 0.88) 0 2px, rgba(255, 255, 255, 0.35) 2px 5px),
      var(--glacier);
    box-shadow: inset 0 0 0 1px rgba(16, 35, 58, 0.18);
  }
</style>
