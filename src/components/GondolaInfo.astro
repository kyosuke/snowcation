---
import IconMan from '~icons/material-symbols-light/man-rounded';

interface Gondola {
  name: string;
  capacity: number;
  length: number;
  cabinSize: 'narrow' | 'standard' | 'wide';
  externalRack: 'ski' | 'snowboard' | 'both' | 'none';
}

interface Props {
  gondolas: Gondola[];
}

const { gondolas } = Astro.props;

const MAX_BAR_LENGTH = 2000;

const cabinSizeLabel: Record<Gondola['cabinSize'], string> = {
  narrow: '狭い',
  standard: '普通',
  wide: '広い',
};

const externalRackLabel: Record<Gondola['externalRack'], string> = {
  ski: 'スキーのみ',
  snowboard: 'ボードのみ',
  both: '両対応',
  none: 'なし',
};
---

<div class="gondola-table-wrapper">
  <table class="gondola-table">
    <thead>
      <tr>
        <th class="col-name">ゴンドラ名</th>
        <th class="col-capacity">乗車人数</th>
        <th class="col-cabin-size">車内の広さ</th>
        <th class="col-rack">外付けラック</th>
        <th class="col-length">ゴンドラ長</th>
      </tr>
    </thead>
    <tbody>
      {gondolas.map(gondola => {
        const bars: number[] = [];
        let remaining = gondola.length;
        while (remaining > 0) {
          const seg = Math.min(remaining, MAX_BAR_LENGTH);
          bars.push(seg);
          remaining -= seg;
        }

        return (
          <tr>
            <td class="col-name">{gondola.name}</td>
            <td class="col-capacity">
              <span class="capacity-icons">
                {Array.from({ length: gondola.capacity }).map(() => (
                  <span class="capacity-icon"><IconMan /></span>
                ))}
              </span>
            </td>
            <td class="col-cabin-size">{cabinSizeLabel[gondola.cabinSize]}</td>
            <td class="col-rack">{externalRackLabel[gondola.externalRack]}</td>
            <td class="col-length">
              <div class="bar-container">
                {bars.map((seg, i) => (
                  <div class="bar-row">
                    <div
                      class="bar"
                      style={`width: ${(seg / MAX_BAR_LENGTH) * 100}%`}
                    />
                    {i === bars.length - 1 && (
                      <span class="bar-label">{gondola.length.toLocaleString()}m</span>
                    )}
                  </div>
                ))}
              </div>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>

<style>
  .gondola-table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .gondola-table-wrapper :global(div) {
    margin-top: 0;
  }

  .gondola-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
    white-space: nowrap;
  }

  .gondola-table thead th {
    text-align: left;
    font-weight: 600;
    color: var(--sl-color-gray-2);
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid var(--sl-color-gray-4);
    font-size: var(--sl-text-xs);
  }

  .gondola-table tbody td {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    vertical-align: middle;
  }

  .gondola-table tbody tr:last-child td {
    border-bottom: none;
  }

  /* Column: Name */
  .col-name {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  /* Column: Capacity */
  .capacity-icons {
    display: flex;
    gap: 0;
    margin-left: -6px;
  }

  .capacity-icon {
    font-size: var(--sl-text-xl);
    color: var(--sl-color-text);
    display: flex;
    align-items: center;
    line-height: 1;
  }

  .capacity-icon + .capacity-icon {
    margin-left: -12px;
  }

  .capacity-icon :global(svg) {
    display: block;
  }

  /* Column: Cabin size / Rack */
  .col-cabin-size,
  .col-rack {
    text-align: center;
    color: var(--sl-color-gray-2);
  }

  /* Column: Length bar */
  .col-length {
    min-width: 10rem;
  }

  .bar-container {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .bar-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bar {
    height: 0.75rem;
    background: linear-gradient(90deg, #4285F4, #5E97F6);
    border-radius: 0.25rem;
    min-width: 0.5rem;
  }

  .bar-label {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    flex-shrink: 0;
  }
</style>
