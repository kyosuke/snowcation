---
import IconMan from '~icons/material-symbols-light/man-rounded';
import IconCheck from '~icons/material-symbols-light/check-rounded';
import IconClose from '~icons/material-symbols-light/close-rounded';

interface Lift {
  name: string;
  capacity: number;
  length: number;
  hood: boolean;
  footrest: boolean;
  safetyBar: boolean;
}

interface Props {
  lifts: Lift[];
}

const { lifts } = Astro.props;

const MAX_BAR_LENGTH = 2000;
---

<div class="lift-table-wrapper">
  <table class="lift-table">
    <thead>
      <tr>
        <th class="col-name">リフト名</th>
        <th class="col-capacity">乗車人数</th>
        <th class="col-hood">フード</th>
        <th class="col-footrest">足置き</th>
        <th class="col-safety-bar">安全バー</th>
        <th class="col-length">リフト長</th>
      </tr>
    </thead>
    <tbody>
      {lifts.map(lift => {
        const bars: number[] = [];
        let remaining = lift.length;
        while (remaining > 0) {
          const seg = Math.min(remaining, MAX_BAR_LENGTH);
          bars.push(seg);
          remaining -= seg;
        }

        return (
          <tr>
            <td class="col-name">{lift.name}</td>
            <td class="col-capacity">
              <span class="capacity-icons">
                {Array.from({ length: lift.capacity }).map(() => (
                  <span class="capacity-icon"><IconMan /></span>
                ))}
              </span>
            </td>
            <td class="col-hood">
              {lift.hood
                ? <span class="icon-yes"><IconCheck /></span>
                : <span class="icon-no"><IconClose /></span>
              }
            </td>
            <td class="col-footrest">
              {lift.footrest
                ? <span class="icon-yes"><IconCheck /></span>
                : <span class="icon-no"><IconClose /></span>
              }
            </td>
            <td class="col-safety-bar">
              {lift.safetyBar
                ? <span class="icon-yes"><IconCheck /></span>
                : <span class="icon-no"><IconClose /></span>
              }
            </td>
            <td class="col-length">
              <div class="bar-container">
                {bars.map((seg, i) => (
                  <div class="bar-row">
                    <div
                      class="bar"
                      style={`width: ${(seg / MAX_BAR_LENGTH) * 100}%`}
                    />
                    {i === bars.length - 1 && (
                      <span class="bar-label">{lift.length.toLocaleString()}m</span>
                    )}
                  </div>
                ))}
              </div>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>

<style>
  .lift-table-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .lift-table-wrapper :global(div) {
    margin-top: 0;
  }

  .lift-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--sl-text-sm);
    white-space: nowrap;
  }

  .lift-table thead th {
    text-align: left;
    font-weight: 600;
    color: var(--sl-color-gray-2);
    padding: 0.5rem 0.75rem;
    border-bottom: 2px solid var(--sl-color-gray-4);
    font-size: var(--sl-text-xs);
  }

  .lift-table tbody td {
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    vertical-align: middle;
  }

  .lift-table tbody tr:last-child td {
    border-bottom: none;
  }

  /* Column: Name */
  .col-name {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  /* Column: Capacity */
  .capacity-icons {
    display: flex;
    gap: 0;
    margin-left: -6px;
  }

  .capacity-icon {
    font-size: var(--sl-text-xl);
    color: var(--sl-color-text);
    display: flex;
    align-items: center;
    line-height: 1;
  }

  .capacity-icon + .capacity-icon {
    margin-left: -12px;
  }

  .capacity-icon :global(svg) {
    display: block;
  }

  /* Column: Hood / Footrest */
  .col-hood,
  .col-footrest,
  .col-safety-bar {
    text-align: center;
  }

  .icon-yes,
  .icon-no {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--sl-text-xl);
    line-height: 1;
  }

  .icon-yes {
    color: #34A853;
  }

  .icon-no {
    color: var(--sl-color-gray-4);
  }

  .icon-yes :global(svg),
  .icon-no :global(svg) {
    display: block;
  }

  /* Column: Length bar */
  .col-length {
    min-width: 10rem;
  }

  .bar-container {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .bar-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bar {
    height: 0.75rem;
    background: linear-gradient(90deg, #4285F4, #5E97F6);
    border-radius: 0.25rem;
    min-width: 0.5rem;
  }

  .bar-label {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    flex-shrink: 0;
  }
</style>
