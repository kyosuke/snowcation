---
interface Props {
  name: string;
  hours: string;
  quality?: string;
  // Facilities keys: 'indoor', 'outdoor', 'cold', 'sauna', 'washing'
  facilities?: string[]; 
  // Amenities keys: 'locker', 'dryer'
  amenities?: string[];
}

const { name, hours, quality, facilities = [], amenities = [] } = Astro.props;

const facilityMap: Record<string, { icon: string; label: string }> = {
  indoor: { icon: '🛁', label: '内湯' },
  outdoor: { icon: '🍃', label: '露天' },
  cold: { icon: '❄️', label: '水風呂' },
  sauna: { icon: '🧖', label: 'サウナ' },
  washing: { icon: '🚿', label: '洗い場' },
};

const amenityMap: Record<string, { icon: string; label: string }> = {
  locker: { icon: '🔑', label: '鍵付きロッカー' },
  dryer: { icon: '💨', label: 'ドライヤー' },
};
---

<div class="onsen-card">
  <div class="onsen-header">
    <div class="onsen-title">{name}</div>
    <div class="onsen-row meta-row">
      <span class="icon">🕒</span>
      <span>{hours}</span>
    </div>
  </div>
  
  <hr class="onsen-divider" />
  
  <div class="onsen-body">
    {quality && (
      <div class="onsen-row quality-row">
        <span class="icon">♨️</span>
        <span>{quality}</span>
      </div>
    )}

    {facilities.length > 0 && (
      <div class="onsen-section facilities-section">
        <div class="facility-icons">
           {facilities.map(f => {
             const item = facilityMap[f];
             return item ? <span class="facility-icon-wrapper">[{item.icon}]</span> : null;
           })}
        </div>
        <div class="facility-labels">
            {facilities.map(f => {
             const item = facilityMap[f];
             return item ? <span class="facility-label">{item.label}</span> : null;
           })}
        </div>
      </div>
    )}

    {amenities.length > 0 && (
      <div class="onsen-section amenities-section">
        <div class="section-title">[脱衣所設備]</div>
        <div class="amenity-list">
           {amenities.map((a, index) => {
             const item = amenityMap[a];
             return item ? (
                <>
                  <span class="amenity-item">
                      {item.icon} {item.label}
                  </span>
                  {index < amenities.length - 1 && <span class="separator"> / </span>}
                </>
             ) : null;
           })}
        </div>
      </div>
    )}
  </div>
</div>

<style>
  .onsen-card {
    border: 1px solid var(--sl-color-gray-5);
    background-color: var(--sl-color-gray-6);
    border-radius: 0.5rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: var(--sl-shadow-sm);
  }

  .onsen-header {
    margin-bottom: 0.5rem;
  }

  .onsen-title {
    font-size: 1.1rem;
    font-weight: bold;
    margin-bottom: 0.25rem;
    color: var(--sl-color-white);
  }

  .onsen-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
  }
  
  .meta-row {
    font-family: var(--sl-font-mono);
  }

  .quality-row {
    margin-bottom: 1.5rem;
    font-weight: 500;
    color: var(--sl-color-text);
  }

  .onsen-divider {
    border: 0;
    border-top: 1px dashed var(--sl-color-gray-4);
    margin: 0.5rem 0 1rem 0;
  }

  .onsen-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .onsen-section {
    display: flex;
    flex-direction: column;
  }

  /* Facilities */
  .facilities-section {
    text-align: center;
  }

  .facility-icons {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
    font-size: 1.2rem;
  }

  .facility-labels {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }
  
  .facility-icon-wrapper {
      letter-spacing: 0.1em;
  }

  /* Amenities */
  .section-title {
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.25rem;
  }

  .amenity-list {
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
  }
  
  .separator {
      margin: 0 0.25rem;
      color: var(--sl-color-gray-4);
  }
</style>
