---
import IconOnsen from "~icons/material-symbols-light/hot-tub-rounded";

interface Props {
  name: string;
  badge?: string;
  hours: string;
  quality?: string;
  facilities?: ("indoor" | "outdoor" | "cold" | "sauna" | "washing")[];
  amenities?: ("locker" | "dryer")[];
}

const { name, badge, hours, quality, facilities = [], amenities = [] } = Astro.props;
const labels = {
  indoor: "内湯",
  outdoor: "露天",
  cold: "水風呂",
  sauna: "サウナ",
  washing: "洗い場",
  locker: "鍵付きロッカー",
  dryer: "ドライヤー",
};
const chips = [...facilities, ...amenities].map((k) => labels[k]);
---

<div class="card">
  <div class="head">
    <div class="title">
      <IconOnsen aria-hidden="true" />
      <h3 class="h3">温泉 · {name}</h3>
    </div>
    {badge && <span class="chip">{badge}</span>}
  </div>
  <dl class="dl nums">
    <dt>時間</dt><dd>{hours}</dd>
    {quality && <><dt>泉質</dt><dd>{quality}</dd></>}
  </dl>
  {chips.length > 0 && <div class="chips">{chips.map((c) => <span class="chip">{c}</span>)}</div>}
  <slot />
</div>

<style>
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .title {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .title svg {
    font-size: 22px;
    color: var(--ink-2);
  }
  .card :global(p) {
    font-size: var(--text-caption);
    line-height: 1.6;
    color: var(--ink-2);
  }
</style>
