---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import ResortCard from "../components/ResortCard.astro";
import logo from "../assets/logo.webp";

const tagline = "ゲレンデに泊まる、スノーリゾートの個人メモ";
const resorts = (await getCollection("resorts")).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Snowcation" description={tagline}>
  <div class="hero">
    <svg aria-hidden="true" class="grain">
      <filter id="grain"
        ><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch"></feTurbulence><feColorMatrix
          type="saturate"
          values="0"></feColorMatrix></filter
      >
      <rect width="100%" height="100%" filter="url(#grain)" opacity="0.5"></rect>
    </svg>
    <div class="fade" aria-hidden="true"></div>
    <Nav variant="top" />
    <header>
      <Image src={logo} alt="Snowcationのロゴ。雪山とホテルを囲む紙細工の円" widths={[200, 400]} sizes="200px" loading="eager" />
      <div class="title">
        <h1>snowcation</h1>
        <p>{tagline}</p>
      </div>
    </header>
  </div>

  <main class="container">
    <div class="grid">{resorts.map((r) => <ResortCard resort={r} />)}</div>
  </main>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60% 70% at 18% 28%, rgba(158, 196, 242, 0.95) 0%, rgba(158, 196, 242, 0) 62%),
      radial-gradient(44% 52% at 82% 22%, rgba(250, 214, 174, 0.9) 0%, rgba(250, 214, 174, 0) 58%),
      radial-gradient(55% 60% at 74% 82%, rgba(111, 174, 255, 0.6) 0%, rgba(111, 174, 255, 0) 62%),
      radial-gradient(42% 48% at 36% 86%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 60%),
      linear-gradient(180deg, #cfe0f3 0%, #e6eff8 100%);
  }
  .grain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mix-blend-mode: soft-light;
    pointer-events: none;
  }
  .fade {
    position: absolute;
    inset: auto 0 0;
    height: 180px;
    background: linear-gradient(180deg, rgba(246, 249, 252, 0) 0%, var(--snow) 100%);
    pointer-events: none;
  }
  header {
    position: relative;
    padding: 48px var(--gutter) 112px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
  }
  header img {
    width: clamp(140px, 30vw, 200px);
    height: auto;
  }
  .title {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  h1 {
    font-family: var(--font-wordmark);
    font-size: clamp(2.667rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
    font-weight: 450;
  }
  .title p {
    color: var(--ink-2);
  }
  main {
    padding-bottom: 16px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
  }
</style>
