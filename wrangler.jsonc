/**
 * 全ページ静的なので Worker スクリプトは持たず、静的アセット配信だけを使う。
 * https://developers.cloudflare.com/workers/static-assets/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snowcation",
  "compatibility_date": "2025-11-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
